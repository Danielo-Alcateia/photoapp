# PhotoApp - variáveis de ambiente (EXEMPLO).
#
# Copie para ".env" e preencha localmente. O arquivo ".env" é IGNORADO pelo
# git e NUNCA deve ser commitado com segredos. Em produção (Render), configure
# estas variáveis no painel: Service -> Environment.

# --- Servidor --------------------------------------------------------------
PORT=10000

# --- Imagem/limites --------------------------------------------------------
# Maior lado aceito após o decode (nuvem free: ~2400; máquina grande: 8000).
PHOTOAPP_MAX_DIM=2400
# Escala de super-resolução padrão (2 ou 4).
PHOTOAPP_UPSCALE=2
# Força o motor de upscale: auto | lanczos | realesrgan
PHOTOAPP_UPSCALE_ENGINE=auto
# Força o motor de inpaint: auto | opencv | lama
PHOTOAPP_INPAINT_ENGINE=auto
# Ligue o warmup de modelos pesados SÓ onde houver RAM (nunca no free 512 MB).
PHOTOAPP_WARMUP=0

# --- Modo IA (Replicate) - pago por uso ------------------------------------
# SEGREDO: gere em https://replicate.com/account/api-tokens. NUNCA versione.
REPLICATE_API_TOKEN=
# Motor de pintura generativa (inpainting).
REPLICATE_MODEL_FILL=black-forest-labs/flux-fill-pro
# Motor de remoção pura (apaga sem alucinar).
REPLICATE_MODEL_ERASER=bria/eraser
# Maior lado enviado à IA (limita custo/latência; 0 = sem limite).
PHOTOAPP_AI_MAX_DIM=1600
# Timeout (s) do polling do Replicate.
REPLICATE_TIMEOUT=120
# Inverter a máscara do Bria Eraser (branco = apagar). false/true.
BRIA_MASK_INVERT=false

# --- Orquestrador automático (auto_edit) -----------------------------------
# Teto de chamadas PAGAS por pedido.
AUTO_MAX_CALLS=2
# Acima disso a edição é considerada "não limpa".
AUTO_RESIDUAL_THRESHOLD=0.18
# Se a 1ª chamada PAGA já vier boa (score <= valor), não gasta a 2ª.
AUTO_EARLY_STOP_SCORE=0.12
# Custo estimado por chamada (US$) - só para exibir no frontend.
COST_FILL_USD=0.045
COST_ERASER_USD=0.035
# Tamanho do cache LRU da detecção de marca d'água (0 desliga).
PHOTOAPP_DETECT_CACHE=20
